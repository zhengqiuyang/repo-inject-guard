{
  "name": "repo-inject-guard",
  "version": "0.1.0",
  "description": "Scan what your coding agent READS — repo poisoning / prompt-injection detection for rules files, docs, issues and PRs",
  "type": "module",
  "license": "MIT",
  "main": "dist/src/cli.js",
  "bin": {
    "repo-inject-guard": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "test/fixtures",
    "rig.example.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node test/run-tests.mjs",
    "demo": "node dist/src/cli.js scan test/fixtures/poisoned-repo",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "prompt-injection",
    "ai-agents",
    "security",
    "code-scanning",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhengqiuyang/repo-inject-guard.git"
  }
}
